{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sessionVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "turns": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\r\\n]+$"
          },
          "agent": {
            "type": "object",
            "properties": {
              "durationMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 120000
              },
              "events": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                        },
                        "atMs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "type": {
                          "type": "string",
                          "const": "assistant_message"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id",
                        "atMs",
                        "type",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                        },
                        "atMs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "type": {
                          "type": "string",
                          "const": "tool_call"
                        },
                        "tool": {
                          "type": "string",
                          "minLength": 1
                        },
                        "input": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "atMs",
                        "type",
                        "tool",
                        "input"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                        },
                        "atMs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "type": {
                          "type": "string",
                          "const": "tool_result"
                        },
                        "callId": {
                          "type": "string",
                          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                        },
                        "output": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "success",
                            "error"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "atMs",
                        "type",
                        "callId",
                        "output",
                        "status"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                        },
                        "atMs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "type": {
                          "type": "string",
                          "const": "file_update"
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "language": {
                          "type": "string",
                          "minLength": 1
                        },
                        "content": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "atMs",
                        "type",
                        "path",
                        "language",
                        "content"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "durationMs",
              "events"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "prompt",
          "agent"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "sessionVersion",
    "title",
    "description",
    "turns"
  ],
  "additionalProperties": false
}
